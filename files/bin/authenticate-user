#!/usr/bin/python3

"""OpenVPN auth-user-pass-verify hook for direct LDAP and optional TOTP.

OpenVPN supplies username and password in the environment when this script is
configured with `via-env`.  Do not print either value: OpenVPN includes this
hook's output in its logs.
"""

import base64
import binascii
import hashlib
import hmac
import json
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys
import time

import ldap
from ldap.filter import escape_filter_chars


OTP_DIRECTORY = Path("/etc/openvpn/otp")
CACHE_DIRECTORY = Path("/etc/openvpn/auth-cache")
CACHE_KEY_FILE = Path("/etc/openvpn/auth-cache.key")
AUTH_SETTINGS_FILE = Path("/etc/openvpn/auth-settings.json")
OTP_CODE = re.compile(r"^[0-9]{6}$")


def load_auth_settings() -> dict[str, str]:
    """Read settings written by the entrypoint for the OpenVPN hook.

    OpenVPN creates a restricted environment for script hooks. In particular,
    it cannot be relied upon to preserve the LDAP settings inherited by the
    daemon. The file is mode 0600 and readable only by the `nobody` account
    which runs both OpenVPN and this verifier.
    """
    try:
        values = json.loads(AUTH_SETTINGS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return {}
    if not isinstance(values, dict):
        return {}
    return {name: value for name, value in values.items() if isinstance(name, str) and isinstance(value, str)}


AUTH_SETTINGS = load_auth_settings()


def option_is_true(name: str) -> bool:
    return setting(name).lower() == "true"


def setting(name: str, default: str = "") -> str:
    return AUTH_SETTINGS.get(name, os.environ.get(name, default))


def cache_duration(name: str, default: int) -> int:
    try:
        duration = int(setting(name, str(default)))
    except ValueError:
        return default
    return duration if duration >= 0 else default


def cache_stale_duration(result: bool) -> int:
    """Return the stale-while-refresh period for a cache result.

    AUTH_CACHE_STALE_TTL is retained as an override for existing deployments.
    Successful authentications get a longer default because they preserve VPN
    availability while LDAP is briefly unavailable; failed authentications do
    not need the same grace period.
    """
    default = 600 if result else 60
    if "AUTH_CACHE_STALE_TTL" in AUTH_SETTINGS or "AUTH_CACHE_STALE_TTL" in os.environ:
        return cache_duration("AUTH_CACHE_STALE_TTL", default)
    name = "AUTH_CACHE_POSITIVE_STALE_TTL" if result else "AUTH_CACHE_NEGATIVE_STALE_TTL"
    return cache_duration(name, default)


def cache_secret() -> bytes | None:
    try:
        secret = CACHE_KEY_FILE.read_bytes().strip()
    except OSError:
        return None
    return secret if len(secret) >= 32 else None


def cache_key(secret: bytes, username: str, password: str) -> str:
    message = username.encode("utf-8", "surrogateescape") + b"\0" + password.encode("utf-8", "surrogateescape")
    return hmac.new(secret, message, hashlib.sha256).hexdigest()


def cache_entry_path(key: str) -> Path:
    return CACHE_DIRECTORY / f"{key}.json"


def refresh_lock_path(key: str) -> Path:
    return CACHE_DIRECTORY / f".{key}.refresh"


def read_cache_entry(key: str) -> dict | None:
    try:
        entry = json.loads(cache_entry_path(key).read_text(encoding="ascii"))
    except (OSError, ValueError, UnicodeDecodeError):
        return None

    if not isinstance(entry, dict) or not isinstance(entry.get("result"), bool):
        return None
    if not all(isinstance(entry.get(field), (int, float)) for field in ("expires_at", "stale_until")):
        return None
    return entry


def write_cache_entry(key: str, result: bool) -> None:
    ttl_name = "AUTH_CACHE_POSITIVE_TTL" if result else "AUTH_CACHE_NEGATIVE_TTL"
    ttl = cache_duration(ttl_name, 120 if result else 30)
    if ttl == 0:
        return

    now = time.time()
    entry = {
        "result": result,
        "expires_at": now + ttl,
        "stale_until": now + ttl + cache_stale_duration(result),
    }
    temporary_path = CACHE_DIRECTORY / f".{key}.{os.getpid()}.{secrets.token_hex(8)}.tmp"
    try:
        fd = os.open(temporary_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="ascii") as cache_file:
            json.dump(entry, cache_file, separators=(",", ":"))
            cache_file.flush()
            os.fsync(cache_file.fileno())
        os.replace(temporary_path, cache_entry_path(key))
    except OSError:
        try:
            temporary_path.unlink()
        except OSError:
            pass


def acquire_refresh_lock(key: str) -> bool:
    lock_path = refresh_lock_path(key)
    lock_ttl = cache_duration("AUTH_CACHE_REFRESH_LOCK_TTL", 30)
    try:
        if time.time() - lock_path.stat().st_mtime > lock_ttl:
            lock_path.unlink()
    except FileNotFoundError:
        pass
    except OSError:
        return False

    try:
        fd = os.open(lock_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return False
    except OSError:
        return False
    else:
        with os.fdopen(fd, "w", encoding="ascii") as lock_file:
            lock_file.write(str(os.getpid()))
        return True


def release_refresh_lock(key: str) -> None:
    try:
        refresh_lock_path(key).unlink()
    except FileNotFoundError:
        pass
    except OSError:
        pass


def refresh_in_background(key: str, ldap_password: str) -> None:
    if not acquire_refresh_lock(key):
        return

    environment = os.environ.copy()
    environment["AUTH_CACHE_REFRESH"] = "1"
    environment["AUTH_CACHE_LDAP_PASSWORD"] = ldap_password
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__)],
            env=environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            start_new_session=True,
        )
    except OSError:
        release_refresh_lock(key)


def read_otp_secret(username: str) -> str | None:
    if not username or "/" in username or "\x00" in username:
        return None

    try:
        secret = (OTP_DIRECTORY / f"{username}.google_authenticator").read_text(encoding="ascii").splitlines()[0]
    except (FileNotFoundError, IndexError, OSError, UnicodeDecodeError):
        return None

    return secret.strip().replace(" ", "")


def totp(secret: str, counter: int) -> str | None:
    try:
        padded_secret = secret.upper() + "=" * (-len(secret) % 8)
        key = base64.b32decode(padded_secret, casefold=True)
    except (ValueError, binascii.Error):
        return None

    digest = hmac.new(key, counter.to_bytes(8, "big"), hashlib.sha1).digest()
    offset = digest[-1] & 0x0F
    code = int.from_bytes(digest[offset : offset + 4], "big") & 0x7FFFFFFF
    return f"{code % 1_000_000:06d}"


def verify_otp(username: str, supplied_password: str) -> str | None:
    """Return the LDAP password only when the appended TOTP code is valid."""
    if len(supplied_password) < 7:
        return None

    ldap_password, supplied_code = supplied_password[:-6], supplied_password[-6:]
    if not OTP_CODE.fullmatch(supplied_code):
        return None

    secret = read_otp_secret(username)
    if not secret:
        return None

    current_counter = int(time.time() // 30)
    for counter in range(current_counter - 1, current_counter + 2):
        expected_code = totp(secret, counter)
        if expected_code and hmac.compare_digest(supplied_code, expected_code):
            return ldap_password
    return None


def configure_tls() -> str:
    encryption = setting("LDAP_ENCRYPT_CONNECTION", "off")
    if option_is_true("LDAP_TLS"):
        encryption = "starttls"

    if encryption not in {"off", "on", "starttls"}:
        raise ValueError("invalid LDAP_ENCRYPT_CONNECTION")

    if setting("LDAP_TLS_VALIDATE_CERT", "true").lower() == "false":
        ldap.set_option(ldap.OPT_X_TLS_REQUIRE_CERT, ldap.OPT_X_TLS_NEVER)

    custom_ca = Path("/etc/openvpn/ldap-ca.crt")
    ca_bundle = custom_ca if custom_ca.is_file() else Path("/etc/ssl/certs/ca-certificates.crt")
    if not ca_bundle.is_file():
        raise OSError("LDAP CA bundle is unavailable")
    ldap.set_option(ldap.OPT_X_TLS_CACERTFILE, str(ca_bundle))
    ldap.set_option(ldap.OPT_X_TLS_NEWCTX, 0)
    return encryption


def ldap_connection(encryption: str):
    uri = setting("LDAP_URI")
    if encryption == "on" and not uri.lower().startswith("ldaps://"):
        raise ValueError("LDAP_ENCRYPT_CONNECTION=on requires an ldaps:// LDAP_URI")

    connection = ldap.initialize(uri)
    connection.set_option(ldap.OPT_PROTOCOL_VERSION, ldap.VERSION3)
    connection.set_option(ldap.OPT_REFERRALS, 0)
    connection.set_option(ldap.OPT_NETWORK_TIMEOUT, 10)
    connection.set_option(ldap.OPT_TIMEOUT, 10)
    if encryption == "starttls":
        connection.start_tls_s()
    return connection


def user_search_filter(username: str) -> str:
    if option_is_true("ACTIVE_DIRECTORY_COMPAT_MODE"):
        attribute = "sAMAccountName"
        restriction = "(objectClass=user)"
    else:
        attribute = setting("LDAP_LOGIN_ATTRIBUTE", "uid")
        restriction = setting("LDAP_FILTER", "(objectClass=posixAccount)")

    # Attribute names and restrictions are operator-controlled configuration.
    # Escape only the untrusted client-supplied username.
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9-]*", attribute):
        raise ValueError("invalid LDAP_LOGIN_ATTRIBUTE")
    if not restriction.startswith("(") or not restriction.endswith(")"):
        raise ValueError("invalid LDAP_FILTER")
    return f"(&({attribute}={escape_filter_chars(username)}){restriction})"


def authenticate_ldap(username: str, password: str) -> bool:
    encryption = configure_tls()
    lookup = ldap_connection(encryption)
    try:
        bind_dn = setting("LDAP_BIND_USER_DN")
        if bind_dn:
            lookup.simple_bind_s(bind_dn, setting("LDAP_BIND_USER_PASS"))

        matches = lookup.search_s(
            setting("LDAP_BASE_DN"), ldap.SCOPE_SUBTREE, user_search_filter(username), ["dn"]
        )
        if len(matches) != 1 or not matches[0][0]:
            return False
        user_dn = matches[0][0]
    finally:
        lookup.unbind_s()

    login = ldap_connection(encryption)
    try:
        try:
            login.simple_bind_s(user_dn, password)
            return True
        except ldap.INVALID_CREDENTIALS:
            return False
    finally:
        login.unbind_s()


def authenticate_with_cache(username: str, password: str) -> bool:
    """Return a fresh result, or stale data while one refresh is in flight."""
    secret = cache_secret()
    if secret is None:
        return authenticate_ldap(username, password)

    key = cache_key(secret, username, password)
    now = time.time()
    entry = read_cache_entry(key)
    if entry is not None:
        if now <= entry["expires_at"]:
            return entry["result"]
        if now <= entry["stale_until"]:
            refresh_in_background(key, password)
            return entry["result"]

    result = authenticate_ldap(username, password)
    write_cache_entry(key, result)
    return result


def run_background_refresh(username: str, password: str) -> int:
    secret = cache_secret()
    if secret is None:
        return 1

    key = cache_key(secret, username, password)
    try:
        result = authenticate_ldap(username, password)
        write_cache_entry(key, result)
        return 0
    except ldap.LDAPError:
        return 1
    finally:
        release_refresh_lock(key)


def main() -> int:
    username = os.environ.get("username")
    password = os.environ.get("password")
    if username is None or password is None:
        return 1

    if setting("AUTH_CACHE_REFRESH") == "1":
        refresh_password = os.environ.get("AUTH_CACHE_LDAP_PASSWORD")
        if refresh_password is None:
            return 1
        return run_background_refresh(username, refresh_password)

    if option_is_true("ENABLE_OTP"):
        password = verify_otp(username, password)
        if password is None:
            return 1

    try:
        return 0 if authenticate_with_cache(username, password) else 1
    except (ldap.LDAPError, OSError, ValueError):
        return 1


if __name__ == "__main__":
    sys.exit(main())
